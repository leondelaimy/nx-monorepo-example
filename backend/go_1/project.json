{
  "name": "backend/go_1",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "backend/go_1",
  "tags": ["backend", "go"],
  "targets": {
     "build": {
     "executor": "nx:run-commands",
      "options": {
        "command": "go build -o dist/{projectRoot} {projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run {projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test {projectRoot}/..."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go fmt {projectRoot}/main.go"
      }
    },
    "tidy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd {projectRoot} && go mod tidy"
      }
    },
    "container": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t ghcr.io/leondelaimy/backend_go_1 -f backend/go_1/Dockerfile ."
      }
    }
  }
}
